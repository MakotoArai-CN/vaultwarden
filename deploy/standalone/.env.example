## Vaultwarden standalone (no Docker)
## Keep this file next to the binary. start.ps1 / start.sh already cd here.

DATA_FOLDER=data
WEB_VAULT_FOLDER=web-vault
WEB_VAULT_ENABLED=true

ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8000
DOMAIN=http://127.0.0.1:8000

## First run: allow creating an account in the web vault.
SIGNUPS_ALLOWED=true

## Admin page /admin — generate with: ./vaultwarden hash
# ADMIN_TOKEN='replace-me'
